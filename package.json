{
  "name": "frontdoor-cursor-experiment",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/install-hooks.cjs",
    "dev": "vite",
    "build": "node scripts/update-prototype-dates.cjs && (tsc -b || true) && rm -rf docs && vite build && rm -rf docs/styles && cp -r styles docs/styles && touch docs/.nojekyll",
    "preview": "vite preview",
    "parse-reviews": "node scripts/parse-tsv-to-reviews.cjs",
    "generate-consumer-tags": "node scripts/generate-consumer-tags.cjs",
    "classify-consumer-tags": "node scripts/classify-consumer-tags.cjs",
    "harness": "node scripts/harness/run-harness.cjs",
    "harness:data": "node scripts/harness/run-harness.cjs --mode data",
    "harness:ui": "node scripts/harness/run-harness.cjs --mode ui",
    "check:local": "node scripts/harness/check-local.cjs"
  },
  "dependencies": {
    "@doordash/prism-react": "file:../web-next/packages/prism-react",
    "framer-motion": "^12.38.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.1",
    "styled-components": "^6.3.12"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "playwright": "^1.58.2",
    "typescript": "~5.6.2",
    "vite": "^6.0.0"
  }
}
